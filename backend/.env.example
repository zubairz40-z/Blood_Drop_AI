MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appname>
PORT=5000
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key

# Email (Nodemailer) — backend only, never exposed to frontend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=BloodDrop <noreply@example.com>

# bKash Payment Gateway — sandbox, backend only
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_CALLBACK_URL=http://localhost:5000/api/payments/bkash/callback

# Road routing (optional) — falls back to Haversine if not set
OSRM_BASE_URL=https://router.project-osrm.org
